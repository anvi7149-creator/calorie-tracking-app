import { Food, FoodLog, UserProfile } from './types';
import { FOOD_DATABASE } from './data';

export const todayIso = () => new Date().toISOString().split('T')[0];

export const readLocalStorage = <T>(key: string, fallback: T): T => {
  try {
    const item = window.localStorage.getItem(key);
    return item ? (JSON.parse(item) as T) : fallback;
  } catch {
    return fallback;
  }
};

export const persistLocalStorage = <T>(key: string, value: T) => {
  try {
    window.localStorage.setItem(key, JSON.stringify(value));
  } catch {
    // no-op for restricted browser storage
  }
};

export const getFoodById = (id: string) => FOOD_DATABASE.find((food) => food.id === id);

export const calculateNutrients = (food: Partial<Food>, quantity: number) => {
  const servingSize = food.servingSize || 1;
  const factor = quantity / servingSize;

  return {
    calories: Math.round((food.calories || 0) * factor),
    protein: Math.round((food.protein || 0) * factor),
    carbs: Math.round((food.carbs || 0) * factor),
    fat: Math.round((food.fat || 0) * factor),
    fiber: Math.round((food.fiber || 0) * factor)
  };
};

export const getUserGreeting = (name: string) => {
  const hour = new Date().getHours();
  if (hour < 12) return `Good morning, ${name}`;
  if (hour < 18) return `Good afternoon, ${name}`;
  return `Good evening, ${name}`;
};

export const getProgressColor = (percent: number) => {
  if (percent < 70) return '#237A57';
  if (percent < 100) return '#D9A441';
  return '#C94F4F';
};

export const getMealLabel = (value: string) => value;

export const getProfileSummary = (user: UserProfile) => {
  return `${user.name} • ${user.currentWeight}kg • ${user.activityLevel}`;
};

export const getNutritionStatus = (user: UserProfile, logs: FoodLog[]) => {
  const calc = logs.reduce(
    (acc, item) => {
      acc.calories += item.calories;
      acc.protein += item.protein;
      acc.carbs += item.carbs;
      acc.fat += item.fat;
      return acc;
    },
    { calories: 0, protein: 0, carbs: 0, fat: 0 }
  );

  const over = calc.calories > user.dailyTarget;
  if (over) return 'You are a little above today\'s target — that is okay, just keep building consistency.';
  if (calc.calories < user.dailyTarget * 0.6) return 'A steady day so far. A balanced meal or snack could help you reach your goal.';
  return 'Nice balance today. Your intake is aligned with your current goals.';
};
