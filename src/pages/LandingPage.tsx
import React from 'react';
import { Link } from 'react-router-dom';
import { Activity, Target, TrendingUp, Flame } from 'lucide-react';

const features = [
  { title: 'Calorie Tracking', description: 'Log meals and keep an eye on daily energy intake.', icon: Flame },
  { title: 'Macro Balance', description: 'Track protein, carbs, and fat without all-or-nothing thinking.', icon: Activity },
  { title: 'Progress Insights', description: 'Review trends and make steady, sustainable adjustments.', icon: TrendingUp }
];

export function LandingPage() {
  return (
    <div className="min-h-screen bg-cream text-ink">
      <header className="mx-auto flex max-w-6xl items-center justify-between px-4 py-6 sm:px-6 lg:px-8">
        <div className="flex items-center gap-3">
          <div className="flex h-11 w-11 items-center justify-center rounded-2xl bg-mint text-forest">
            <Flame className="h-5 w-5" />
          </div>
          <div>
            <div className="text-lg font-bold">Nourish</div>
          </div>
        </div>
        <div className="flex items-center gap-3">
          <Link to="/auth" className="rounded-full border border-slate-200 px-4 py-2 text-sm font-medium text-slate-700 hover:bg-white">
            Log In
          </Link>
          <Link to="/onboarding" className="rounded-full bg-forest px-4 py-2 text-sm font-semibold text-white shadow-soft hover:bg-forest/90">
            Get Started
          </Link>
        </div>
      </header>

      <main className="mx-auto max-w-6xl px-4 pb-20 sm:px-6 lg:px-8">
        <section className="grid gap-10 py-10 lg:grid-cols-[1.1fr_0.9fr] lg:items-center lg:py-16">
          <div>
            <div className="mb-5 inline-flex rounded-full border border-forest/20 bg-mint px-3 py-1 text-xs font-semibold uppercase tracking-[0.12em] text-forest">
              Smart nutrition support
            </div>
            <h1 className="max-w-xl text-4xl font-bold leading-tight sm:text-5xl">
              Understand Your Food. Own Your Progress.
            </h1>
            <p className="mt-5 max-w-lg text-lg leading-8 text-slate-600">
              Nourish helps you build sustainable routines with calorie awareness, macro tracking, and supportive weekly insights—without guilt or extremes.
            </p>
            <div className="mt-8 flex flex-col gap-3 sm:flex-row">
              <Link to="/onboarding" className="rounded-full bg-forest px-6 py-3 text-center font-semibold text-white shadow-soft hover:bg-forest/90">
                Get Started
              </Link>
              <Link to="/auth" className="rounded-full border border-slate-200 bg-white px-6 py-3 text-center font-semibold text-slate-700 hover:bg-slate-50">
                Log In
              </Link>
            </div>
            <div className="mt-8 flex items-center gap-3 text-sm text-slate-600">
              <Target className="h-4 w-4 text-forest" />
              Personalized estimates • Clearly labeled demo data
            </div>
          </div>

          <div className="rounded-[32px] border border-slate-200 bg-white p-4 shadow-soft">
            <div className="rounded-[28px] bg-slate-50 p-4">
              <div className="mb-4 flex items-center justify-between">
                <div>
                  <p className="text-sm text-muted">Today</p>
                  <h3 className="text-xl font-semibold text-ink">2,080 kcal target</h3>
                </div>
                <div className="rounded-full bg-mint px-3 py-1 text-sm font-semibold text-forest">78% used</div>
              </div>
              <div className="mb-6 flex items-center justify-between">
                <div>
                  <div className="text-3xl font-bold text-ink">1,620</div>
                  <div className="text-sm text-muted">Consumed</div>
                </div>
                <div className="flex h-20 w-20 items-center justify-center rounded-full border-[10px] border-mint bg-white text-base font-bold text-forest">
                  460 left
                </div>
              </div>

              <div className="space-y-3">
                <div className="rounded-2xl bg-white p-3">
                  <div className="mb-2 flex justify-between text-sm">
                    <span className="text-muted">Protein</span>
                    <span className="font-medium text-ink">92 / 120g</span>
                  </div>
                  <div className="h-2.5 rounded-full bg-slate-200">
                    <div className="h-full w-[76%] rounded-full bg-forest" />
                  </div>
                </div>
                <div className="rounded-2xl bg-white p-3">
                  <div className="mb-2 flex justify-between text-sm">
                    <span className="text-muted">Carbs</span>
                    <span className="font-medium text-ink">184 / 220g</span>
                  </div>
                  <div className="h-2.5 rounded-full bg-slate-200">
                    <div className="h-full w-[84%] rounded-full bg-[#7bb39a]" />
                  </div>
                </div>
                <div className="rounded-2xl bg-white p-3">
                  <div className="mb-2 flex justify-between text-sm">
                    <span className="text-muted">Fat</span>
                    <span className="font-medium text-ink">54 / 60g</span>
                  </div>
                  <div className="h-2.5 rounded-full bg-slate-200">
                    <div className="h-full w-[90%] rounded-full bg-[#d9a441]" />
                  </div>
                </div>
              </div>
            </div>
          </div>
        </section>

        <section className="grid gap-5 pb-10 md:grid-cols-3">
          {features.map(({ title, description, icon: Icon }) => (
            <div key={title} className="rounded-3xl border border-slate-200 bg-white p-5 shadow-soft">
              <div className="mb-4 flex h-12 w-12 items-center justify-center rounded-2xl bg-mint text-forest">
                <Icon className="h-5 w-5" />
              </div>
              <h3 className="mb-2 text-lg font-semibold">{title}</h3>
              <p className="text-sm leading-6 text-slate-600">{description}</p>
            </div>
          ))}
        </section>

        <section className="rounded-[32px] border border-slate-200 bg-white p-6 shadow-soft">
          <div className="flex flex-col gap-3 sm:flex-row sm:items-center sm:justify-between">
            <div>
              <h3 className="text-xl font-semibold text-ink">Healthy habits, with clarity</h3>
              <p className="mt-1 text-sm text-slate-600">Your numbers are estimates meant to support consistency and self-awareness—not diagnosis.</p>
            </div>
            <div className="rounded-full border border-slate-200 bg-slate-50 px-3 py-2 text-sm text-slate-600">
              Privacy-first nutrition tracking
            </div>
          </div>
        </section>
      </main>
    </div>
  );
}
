import React from 'react';
import { PencilLine, Trash2 } from 'lucide-react';
import { FoodLog, MealType } from '../types';
import { Link } from 'react-router-dom';

export function MealSection({
  title,
  logs,
  onDelete,
  onEdit,
  onAdd
}: {
  title: MealType;
  logs: FoodLog[];
  onDelete: (id: string) => void;
  onEdit: (id: string) => void;
  onAdd: (meal: MealType) => void;
}) {
  const total = logs.reduce((sum, item) => sum + item.calories, 0);

  return (
    <div className="rounded-3xl border border-slate-200 bg-white p-4 shadow-soft">
      <div className="mb-3 flex items-center justify-between">
        <div className="text-lg font-semibold text-ink">{title}</div>
        <div className="text-sm text-muted">{total} kcal</div>
      </div>

      <div className="space-y-3">
        {logs.length === 0 ? (
          <div className="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-muted">
            No {title.toLowerCase()} entries yet.
          </div>
        ) : (
          logs.map((entry) => (
            <div key={entry.id} className="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3">
              <div className="min-w-0 flex-1">
                <div className="truncate font-medium text-ink">{entry.foodName}</div>
                <div className="text-xs text-muted">
                  {entry.quantity} {entry.servingUnit} • {entry.calories} kcal
                </div>
              </div>
              <div className="flex items-center gap-2">
                <button
                  className="rounded-xl border border-slate-200 p-2 text-slate-700 hover:bg-white"
                  onClick={() => onEdit(entry.id)}
                  aria-label={`Edit ${entry.foodName}`}
                >
                  <PencilLine className="h-4 w-4" />
                </button>
                <button
                  className="rounded-xl border border-slate-200 p-2 text-slate-700 hover:bg-white"
                  onClick={() => onDelete(entry.id)}
                  aria-label={`Delete ${entry.foodName}`}
                >
                  <Trash2 className="h-4 w-4" />
                </button>
              </div>
            </div>
          ))
        )}
      </div>

      <button
        onClick={() => onAdd(title)}
        className="mt-4 w-full rounded-2xl border border-forest/20 bg-mint px-3 py-2 text-sm font-medium text-forest"
      >
        Add Food
      </button>
    </div>
  );
}
